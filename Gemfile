source "https://rubygems.org"

# GitHub Pages-compatible build. `github-pages` pins Jekyll + plugins to the
# exact versions GitHub Pages runs server-side, so local previews match prod.
gem "github-pages", group: :jekyll_plugins
gem "jekyll-seo-tag"

# Lock platform-specific gems for reproducible local installs.
gem "webrick", "~> 1.8"
